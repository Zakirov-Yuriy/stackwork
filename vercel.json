{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "buildCommand": "pnpm db:deploy && pnpm build",
  "crons": [
    {
      "path": "/api/cron/import",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 6 * * 1"
    }
  ]
}
