// Prisma schema for Stackwork.
// Подключение к базе задаётся в prisma.config.ts (DATABASE_URL из .env).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Пользователи ─────────────────────────────

enum UserRole {
  CANDIDATE // соискатель
  EMPLOYER // работодатель
  ADMIN
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  name            String?
  role            UserRole  @default(CANDIDATE)
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  applications Application[]
  vacancies    Vacancy[]           @relation("VacancyAuthor")
  tokens       VerificationToken[]
  saved        SavedVacancy[]
  reports      Report[]
  claims       CompanyClaim[]
  importRuns   ImportRun[]

  @@index([companyId])
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// Одноразовые ссылки из писем. Хранится sha256 от токена, сам токен только в письме.
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model SavedVacancy {
  userId    String
  vacancyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancy   Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@id([userId, vacancyId])
  @@index([vacancyId])
}

enum ReportStatus {
  OPEN
  RESOLVED
}

// Жалоба на вакансию: от пользователя или гостя (тогда userId пустой)
model Report {
  id        String       @id @default(cuid())
  vacancyId String
  vacancy   Vacancy      @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason    String
  comment   String?
  email     String?
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())

  @@index([status, createdAt])
}

// ───────────────────────────── Компании ─────────────────────────────

model Company {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  // Нормализованное имя для склейки компаний из разных источников: «gitlab»
  nameKey     String?  @unique
  description String?
  industry    String?
  city        String?
  website     String?
  logoUrl     String?
  // Аббревиатура для аватара, если нет логотипа: «КБ», «ОМ»
  initials    String?
  // Компания создана импортом и ещё никем не подтверждена
  isExternal  Boolean  @default(false)
  claimedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members   User[]
  vacancies Vacancy[]
  claims    CompanyClaim[]
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

// Запрос «Это ваша компания?»: работодатель забирает страницу компании, созданную импортом
model CompanyClaim {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String?
  status    ClaimStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([companyId, userId])
  @@index([status])
}

// ───────────────────────────── Вакансии ─────────────────────────────

enum Grade {
  JUNIOR
  MIDDLE
  SENIOR
  LEAD
}

enum WorkFormat {
  REMOTE // удалённо
  HYBRID // гибрид
  OFFICE // офис
  REMOTE_OR_OFFICE // на выбор
}

enum Employment {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum SalaryType {
  NET // на руки
  GROSS // до вычета
}

enum ExperienceLevel {
  NONE // без опыта
  ONE_TO_THREE
  THREE_TO_SIX
  SIX_PLUS
}

enum VacancyStatus {
  DRAFT
  MODERATION
  PUBLISHED
  ARCHIVED
  REJECTED
}

// Откуда вакансия: размещена работодателем у нас (MANUAL) или импортирована
enum VacancySource {
  MANUAL
  REMOTIVE
  JOBICY
  REMOTEOK
  HIMALAYAS
  ARBEITNOW
  GREENHOUSE
  LEVER
  ASHBY
}

enum SalaryPeriod {
  MONTH
  YEAR
  HOUR
}

model Vacancy {
  id    String @id @default(cuid())
  slug  String @unique
  title String

  // ── Импорт ──
  source      VacancySource @default(MANUAL)
  externalId  String? // id вакансии в источнике
  externalUrl String? // страница вакансии в источнике (для ссылки на источник)
  applyUrl    String? // куда ведёт «Откликнуться» у импортированных
  // Полное описание из источника как есть (очищенный HTML)
  descriptionHtml String?
  language        String   @default("ru")
  salaryPeriod    SalaryPeriod @default(MONTH)
  // Для удалённых вакансий: откуда берут кандидатов, «Europe, USA»
  locationNote String?
  importedAt   DateTime?
  lastSeenAt   DateTime?
  expiresAt    DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  authorId  String?
  author    User?   @relation("VacancyAuthor", fields: [authorId], references: [id])

  direction  String // Backend, Frontend, DevOps / SRE, Data / ML, QA…
  grade      Grade
  experience ExperienceLevel
  workFormat WorkFormat
  employment Employment
  city       String?

  // Зарплата обязательна: вакансии без вилки не публикуются.
  salaryFrom Int?
  salaryTo   Int?
  currency   String     @default("RUB")
  salaryType SalaryType @default(NET)

  // Разделы описания, каждый отдельным полем (списки через перенос строки).
  aboutTeam        String?
  responsibilities String?
  requirements     String?
  niceToHave       String?
  conditions       String?

  acceptsGithubLink Boolean @default(false)
  showCompanyName   Boolean @default(true)

  status            VacancyStatus @default(DRAFT)
  moderationComment String? // причина отклонения, видна работодателю
  publishedAt       DateTime?
  views             Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Полнотекстовый индекс (русская морфология). Колонка GENERATED, заполняется базой.
  search Unsupported("tsvector")?

  skills       VacancySkill[]
  applications Application[]
  savedBy      SavedVacancy[]
  reports      Report[]
  pageViews    PageView[]

  @@unique([source, externalId])
  @@index([status, publishedAt])
  @@index([companyId])
  @@index([grade])
  @@index([workFormat])
  @@index([source, lastSeenAt])
}

// Справочник технологий: Go, PostgreSQL, Kafka…
model Skill {
  id   String @id @default(cuid())
  slug String @unique
  name String

  vacancies VacancySkill[]
}

model VacancySkill {
  vacancyId String
  skillId   String
  order     Int    @default(0)

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([vacancyId, skillId])
  @@index([skillId])
}

// ───────────────────────────── Отклики ─────────────────────────────

enum ApplicationStatus {
  NEW
  VIEWED
  INTERVIEW
  OFFER
  REJECTED
}

model Application {
  id          String            @id @default(cuid())
  vacancyId   String
  vacancy     Vacancy           @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   User              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  coverLetter String?
  githubUrl   String?
  resumeUrl   String?
  status      ApplicationStatus @default(NEW)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([vacancyId, candidateId])
  @@index([candidateId])
}

// ───────────────────────────── Импорт ─────────────────────────────

enum ImportRunStatus {
  RUNNING
  OK
  ERROR
}

enum ImportTrigger {
  CRON
  ADMIN
}

// Один запуск импорта по одному источнику
model ImportRun {
  id          String          @id @default(cuid())
  source      VacancySource
  trigger     ImportTrigger
  triggeredBy String?
  user        User?           @relation(fields: [triggeredBy], references: [id], onDelete: SetNull)
  status      ImportRunStatus @default(RUNNING)
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?
  fetched     Int             @default(0) // получено из источника
  created     Int             @default(0)
  updated     Int             @default(0)
  skipped     Int             @default(0) // не IT, без зарплаты, не на английском…
  archived    Int             @default(0)
  error       String?
  notes       String? // короткий журнал: что отфильтровано и почему

  @@index([source, startedAt])
  @@index([startedAt])
}

// ───────────────────────────── Статистика ─────────────────────────────

enum PageKind {
  HOME
  VACANCY
  COMPANY
  AUTH
  EMPLOYER
  APPLY // переход по кнопке «Откликнуться» к работодателю
  OTHER
}

enum DeviceKind {
  DESKTOP
  MOBILE
  TABLET
}

// Просмотр страницы. Без cookie: посетитель = хэш(день + IP + User-Agent + секрет),
// адрес не хранится. Роботы не записываются.
model PageView {
  id          Int        @id @default(autoincrement())
  day         DateTime   @db.Date
  createdAt   DateTime   @default(now())
  path        String
  kind        PageKind
  vacancyId   String?
  vacancy     Vacancy?   @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  visitorHash String
  device      DeviceKind
  // Откуда пришли: хост реферера («google.com») или null для прямого захода
  referrerHost String?
  // Внутренний источник перехода: с какого экрана открыли карточку
  from        String?

  @@index([day])
  @@index([day, visitorHash])
  @@index([vacancyId, day])
}

// Настройки сайта и импорта: ключ → JSON
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
