# Скопируйте в .env и при необходимости поправьте.
# Значения совпадают с docker-compose.yml.
DATABASE_URL="postgresql://stackwork:stackwork@localhost:5432/stackwork?schema=public"

# Секрет для подписи сессий (минимум 32 символа). Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Адрес сайта (для ссылок в письмах, sitemap и Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Почта. Если SMTP_HOST не задан, письма печатаются в консоль dev-сервера.
# Подходит любой SMTP: Resend, Brevo, Postmark, Mailgun, Яндекс 360.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Stackwork <no-reply@example.com>"

# Капча Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile). Пусто = выключена.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Отключить лимиты запросов (только для локальных автотестов). В продакшене не задавать.
# RATE_LIMIT_OFF="1"

# Секрет для ежедневного импорта вакансий по расписанию (/api/cron/import). На Vercel задайте
# такой же в переменных окружения проекта: Vercel сам присылает его в заголовке Authorization.
CRON_SECRET="change-me-to-another-long-random-string"

# Контакт для User-Agent запросов к источникам вакансий (адрес сайта берётся из NEXT_PUBLIC_SITE_URL)
CONTACT_EMAIL="hello@stackwork.example"
